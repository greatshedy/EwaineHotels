# AstraDB
ASTRA_DB_TOKEN=replace_me
ASTRA_DB_API_ENDPOINT=replace_me
ASTRA_DB_KEYSPACE=default_keyspace

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRY_HOURS=24

# Admin
ADMIN_EMAIL=admin@ewaine.com
ADMIN_PASSWORD=replace_me

# CORS (comma-separated allowed origins, or * for development)
CORS_ORIGINS=http://localhost:5173

# Flutterwave
FLUTTERWAVE_SECRET_KEY=replace_me
FLUTTERWAVE_PUBLIC_KEY=replace_me
FLUTTERWAVE_ENCRYPTION_KEY=replace_me
# Currency for charges (account default is used if left as account currency)
FLUTTERWAVE_CURRENCY=NGN
# Override the return URL after payment (defaults to the requesting origin + /payment/status)
FLUTTERWAVE_REDIRECT_URL=

# Contact form (EmailJS REST API, called server-side)
EMAIL_JS_PUBLIC_KEY=
EMAIL_JS_PRIVATE_KEY=
EMAIL_JS_SERVICE_ID=
EMAIL_JS_TEMPLATE_ID=
CONTACT_RECIPIENT=

# Flask environment (development | production)
FLASK_ENV=development
